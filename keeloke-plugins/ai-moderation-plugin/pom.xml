<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <groupId>tv.keeloke.plugins</groupId>
    <artifactId>ai-moderation-plugin</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Keeloke TV - AI Moderation &amp; Detection Plugin</name>
    <description>
        Provider-agnostic AI content moderation and object detection for live
        streams, with no built-in license: samples frames with FFmpeg and sends
        them to whatever vision API you have a key for - OpenAI (and any
        OpenAI-compatible endpoint: Groq, Together, OpenRouter, local vLLM),
        Anthropic Claude, or ANY HTTP endpoint via the generic adapter (AWS
        Rekognition, Google Vision, Azure Content Safety, Sightengine, Hive, or
        your own service). On a flagged frame it logs, fires a webhook, and/or
        stops the broadcast. Disabled until you set a provider + API key.
    </description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <ant-media-server.version>3.0.3</ant-media-server.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.antmedia</groupId>
            <artifactId>ant-media-server</artifactId>
            <version>${ant-media-server.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
            <version>3.24.3</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.16.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>6.1.6</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.9</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>keeloke-ai-moderation-plugin</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
