<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <groupId>tv.keeloke.plugins</groupId>
    <artifactId>cluster-registry-plugin</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Keeloke TV - Cluster Coordination Plugin</name>
    <description>
        Multi-node coordination for a Keeloke TV Server deployment, with no Ant
        Media Enterprise license: each node heartbeats identity, role
        (origin/edge/hybrid), region, capacity and CPU load into Redis and
        records itself as the origin of every stream it ingests. On top of that
        registry it adds least-loaded origin selection and edge pull-URL routing
        (ClusterLoadBalancer), dead-node detection with orphaned-stream cleanup
        and failover webhooks (ClusterFailoverMonitor), and a load signal +
        Prometheus metrics an EXTERNAL autoscaler (K8s HPA / AWS ASG / GCP MIG)
        consumes to scale the fleet (ClusterAutoScaleAdvisor). The server never
        holds cloud credentials to launch instances itself - see
        keeloke-plugins/CLUSTERING_AND_SCALE_ROADMAP.md.
    </description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <ant-media-server.version>3.0.3</ant-media-server.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.antmedia</groupId>
            <artifactId>ant-media-server</artifactId>
            <version>${ant-media-server.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
            <version>3.24.3</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>6.1.6</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.9</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>keeloke-cluster-registry-plugin</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
